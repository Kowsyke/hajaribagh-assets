give @s written_book[written_book_content={author:"King Abir, Ahsan, Dip, Safwan, Rohit",title:"Hajaribagh Gazette",pages:[{text:"=== HAJARIBAGH ===\n\nJatio Sangsad of Hajaribagh\n(Kingdom of King Abir)\n\nEdition: v4.1 (2026-10-22)\nParliamentary Gazette\n\nAuthors:\n* King Abir\n* Ahsan\n* Dip\n* Safwan (Goth Hunter)\n* Rohit ATB"},{text:"=== EXECUTIVE HIERARCHY ===\n\nKing Abir alone retains supreme sovereign authority.\n\nAll ministers, first lady, and incoming citizens share equal status beneath the King.\n\n* King Abir (Kowsyke)\nPrime Minister & Supreme Ruler\n\n* Ahsane (@sanerar)\nPresident (Rashtrapati)"},{text:"=== MINISTRIES ===\n\n* Dip (Moderator)\nMinister of Communication\n(Jogajog Montri, GitHub Ops)\n\n* Safwan (GothHunterJamal)\nMinister of Tourism, Wildlife & Hunting (Explorer)\n\n* Rohit ATB\n(GREAT-RED-DRAGO)\nMinister of Agriculture &\nTannery (Hajaribagh Local)"},{text:"=== CITIZENS & BASE ===\n\n* King Abir's Girlfriend\nHonorable First Lady\n\n* New Members\nAll new arrivals join as equal citizens of Hajaribagh.\n\nBase Coordinates:\nX: 163, Y: 100, Z: -307\n(East from world spawn)\nLondon Node: 24/7 Active"},{text:"=== ACTIVE MODS ===\n\n* NetherPortalFix:\nPortals link accurately.\n\n* Double Doors:\nOpens both doors and gates.\n\n* RightClickHarvest:\nRight-click to harvest crops.\n\n* Lootr:\nSeparate loot per player."},{text:"=== CANNABIS FARMING ===\n\n1. Get Seeds:\nCraft 1 Wheat Seed + 1 Dried Kelp = 2 Cannabis Seeds. Or punch wild ferns in nature.\n\n2. Plant & Grow:\nPlant on hydrated farmland. Bonemeal accelerates growth into tall 2-block stalks."},{text:"=== HARVEST & ROLL ===\n\n3. Harvest:\nRight-click mature stalk to get Raw Buds and Seeds.\n\n4. Cure Buds:\nDry raw buds on a campfire, in a smoker, or in a furnace to get Cured Buds.\n\n5. Roll & Smoke:\nCraft 1 Cured Bud + 1 Paper = 3 Joints! Right-click to puff."},{text:"=== COMMANDS & HELP ===\n\n* /trigger guide (Get book)\n* /trigger smoke (Puff)\n* /ledger inspect (Anti-grief)\n* /spark health (Server TPS)\n\nParliamentary Contacts:\n* King Abir (Prime Minister)\n* Dip (Communication / Mod)\ngithub.com/Kowsyke/\nhajaribagh-assets"},{text:"=== PRESIDENT AHSANE ===\n\nAhsane (@sanerar)\nHonorable President (Canada)\n\nStatus:\nSingle, heterosexual, and searching for a first lady.\n\nSubmit applications to Ahsan for parliamentary blessings, foreign aid, political strategy, and financial loans."},{text:"=== HAJARIBAGH LORE ===\n\nNamed after Hajaribagh, Dhaka, real-life home turf of Rohit ATB (GREAT-RED-DRAGO).\n\nRenowned for leather, tanneries, and agriculture. Direct all farm subsidies to Minister Rohit."}]}]
