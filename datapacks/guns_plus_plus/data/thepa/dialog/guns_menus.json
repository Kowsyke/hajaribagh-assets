{
  "type": "minecraft:multi_action",
  "inputs": [
    {
      "type": "minecraft:single_option",
      "key": "mob_frequency",
      "label": "Mob Frequency",
      "label_visible": true,
      "options": [
        {
          "id": "0",
          "display": "None",
          "initial": true
        },
        {
          "id": "1",
          "display": "1/50",
          "initial": false
        },
        {
          "id": "2",
          "display": "1/25",
          "initial": false
        },
        {
          "id": "3",
          "display": "1/10",
          "initial": false
        },
        {
          "id": "4",
          "display": "1/5",
          "initial": false
        }
      ]
    },
    {
      "type": "minecraft:boolean",
      "key": "bloom_choice",
      "label": "Bloom",
      "initial": true,
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:boolean",
      "key": "recoil_choice",
      "label": "Recoil",
      "initial": false,
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:boolean",
      "key": "camera_choice",
      "label": "Camera Movement",
      "initial": false,
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:boolean",
      "key": "spray_choice",
      "label": "Spray Patterns",
      "initial": false,
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:boolean",
      "key": "block_break",
      "label": "Projectiles Break Blocks",
      "initial": false,
      "on_true": "1",
      "on_false": "0"
    },
    {
      "type": "minecraft:boolean",
      "key": "add_or_remove",
      "label": "Infinite Reload (no ammo)",
      "initial": true,
      "on_true": "add",
      "on_false": "remove"
    },
    {
      "type": "minecraft:boolean",
      "key": "legacy_controls",
      "label": "Legacy Controls (Right Click to Shoot)",
      "initial": false,
      "on_true": "1",
      "on_false": "0"
    }
  ],
  "can_close_with_escape": true,
  "pause": true,
  "after_action": "close",
  "columns": 1,
  "title": "Guns++ Menu",
  "actions": [
    {
      "label": "Give Recipe Book",
      "action": {
        "type": "minecraft:run_command",
        "command": "function thepa:give/recipe_book"
      }
    },
    {
      "label": "Save Changes",
      "action": {
        "type": "dynamic/run_command",
        "template": "function thepa:utilities/dialog_updates {mob_frequency:$(mob_frequency),bloom_choice:$(bloom_choice),spray_choice:$(spray_choice),block_break:$(block_break),camera_choice:$(camera_choice),recoil_choice:$(recoil_choice),add_or_remove:$(add_or_remove),legacy_controls:$(legacy_controls)}"
      }
    }
  ]
}